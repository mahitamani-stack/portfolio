{
  "redirects": [
    { "source": "/approach", "destination": "/my-journey", "permanent": true },
    { "source": "/portfolio", "destination": "/the-kitchen", "permanent": true },
    { "source": "/portfolio/saba-portfolio-viewer", "destination": "/portfolio/3d-portfolio-viewer", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff2?|ttf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|ico|glb|mp4|mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
